# ==============================================================================
# OrganAIzer Services – Backend Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ==============================================================================


# ------------------------------------------------------------------------------
# API KEY AUTHENTICATION (required — backend will not start without this)
# ------------------------------------------------------------------------------

# Comma-separated list of valid API keys for the X-API-Key request header.
# Generate strong random values, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
API_KEYS=your-api-key-here,optional-second-key


# ------------------------------------------------------------------------------
# CORE AI KEYS
# ------------------------------------------------------------------------------

# OpenRouter API key — required for all LLM interactions
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM model used for chat completions via OpenRouter.
# Default (if omitted): google/gemini-2.5-flash
# Examples: openai/gpt-4o, meta-llama/llama-3.1-8b-instruct, mistralai/mistral-7b-instruct
# Full list: https://openrouter.ai/models
MODEL=google/gemini-2.5-flash

# Google AI Studio API key — used for Gemini image generation
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here


# ------------------------------------------------------------------------------
# GOOGLE OAUTH (required for Gmail + Google Calendar)
# Set up at: https://console.cloud.google.com/apis/credentials
# ------------------------------------------------------------------------------

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret


# ------------------------------------------------------------------------------
# MICROSOFT OAUTH (required for Outlook + Outlook Calendar)
# Set up at: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
# ------------------------------------------------------------------------------

MICROSOFT_CLIENT_ID=your_azure_application_client_id
MICROSOFT_CLIENT_SECRET=your_azure_client_secret_value
# Use "consumers" for personal accounts, "common" for personal+work, or your specific tenant UUID
# Use "common" for All Entra ID + personal MS accounts (recommended)
# Use "consumers" for personal only, "organizations" for work only, or a specific tenant GUID
MICROSOFT_TENANT_ID=common
# Must exactly match the Redirect URI registered in Azure Portal > App Registration > Authentication
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/integrations/microsoft/auth/callback


# ------------------------------------------------------------------------------
# TOKEN ENCRYPTION
# Used to encrypt stored OAuth tokens at rest (Fernet symmetric encryption).
# Generate a key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: If you change this key, all existing tokens become unreadable.
#            Users will need to re-authenticate.
# ------------------------------------------------------------------------------

TOKEN_ENCRYPTION_KEY=your_fernet_encryption_key_here


# ------------------------------------------------------------------------------
# OAUTH REDIRECT URLS
# Must match the redirect URIs registered in Google Cloud Console and Azure Portal
# ------------------------------------------------------------------------------

# Base URL of this backend (used for OAuth callback construction)
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# URL of the frontend (OAuth success/error redirects here)
FRONTEND_URL=http://localhost:5173


# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------

API_HOST=0.0.0.0
API_PORT=8000

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Optional: write logs to file (leave empty for stdout only)
LOG_FILE_PATH=

# Temporary directories for generated files
TTS_TEMP_DIR=./data/tts
IMAGE_GEN_TEMP_DIR=./data/images


# ------------------------------------------------------------------------------
# EXECUTIVE AGENT SETTINGS
# ------------------------------------------------------------------------------

# Internal base URL of this backend.
# Used by the Executive Agent when it calls integration endpoints on itself
# (e.g. to create calendar events or send emails via /api/integrations/*).
# Default: http://localhost:8000 — change this in production to the real backend URL.
BACKEND_URL=http://localhost:8000

# Timezone used for date/time calculations in the Executive Agent.
# Examples: Europe/Berlin, America/New_York, UTC, Asia/Tokyo
# See https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Europe/Berlin

# Enable verbose debug logging for the realtime voice WebSocket (true/false).
# When true, the backend sends {"type":"debug", "data":{...}} frames so the
# frontend debug panel can show per-turn latencies.
VOICE_DEBUG=false

# ── STT model selection ────────────────────────────────────────────────────
# VOICE_STT_MODEL  : Whisper model for realtime voice / WebSocket STT.
#   Use "base" or "small" for low latency on CPU.
#   Use "medium" or "large" only when GPU is available.
#   Default: base
VOICE_STT_MODEL=base

# UPLOAD_STT_MODEL : Whisper model for batch file-upload transcription (/api/stt).
#   Larger models produce better accuracy; latency is less critical here.
#   Default: medium
UPLOAD_STT_MODEL=medium

# ── uvicorn file-watcher ───────────────────────────────────────────────────
# BACKEND_RELOAD : Enable uvicorn --reload (hot-reload on file changes).
#   WARNING: Setting this to true WILL wipe in-memory session state on every
#   reload, clearing pending_action / active_task and disconnecting WebSockets.
#   DO NOT use true when testing voice mode or the executive agent.
#   Run with --no-reload:   uvicorn main:app --no-reload
#   Default: false
BACKEND_RELOAD=false


# ------------------------------------------------------------------------------
# VOICE / AI PHONE MODULE
# Requires a dedicated user created in COMtrexx:
#   https://172.20.0.244 → Benutzer → Neu
#   Set a SIP password under: Benutzer → [user] → Telefonie → SIP-Zugangsdaten
# ------------------------------------------------------------------------------

# COMtrexx PBX address
COMTREXX_IP=172.20.0.244
COMTREXX_SIP_PORT=5060

# Credentials for the AI Agent user in COMtrexx
COMTREXX_SIP_USER=            # SIP username — usually the extension number
COMTREXX_SIP_PASS=            # SIP password set in COMtrexx user profile
COMTREXX_SIP_DOMAIN=172.20.0.244
COMTREXX_EXTENSION=           # Internal extension, e.g. 200
COMTREXX_CALLER_ID=           # Outgoing number shown to called parties

# AI call behaviour
AI_GREETING=Hallo, hier ist Ihr KI-Assistent. Wie kann ich helfen?
AI_LANGUAGE=de
AI_MAX_CALL_SECONDS=300
AI_TRANSFER_EXTENSION=        # Extension of a human agent to transfer to

# Seconds to wait for operator decision (AI vs human) on each inbound/outbound call.
# After this timeout the AI answers automatically. Default: 15
AI_RING_TIMEOUT_SECONDS=15

# Business hours (24 h, server local time)
AI_AFTER_HOURS_START=18
AI_AFTER_HOURS_END=8

# Contacts spreadsheet (place file in backend/)
CONTACTS_FILE=AI_Phone_Contacts.xlsx

# Waiting room extensions for call escalation (internal COMtrexx extensions)
AI_WAITING_ROOM_PRIMARY=778
AI_WAITING_ROOM_SECONDARY=779

# Optional: silence threshold for caller recording (raise for noisy VoIP lines)
# Default: 500 — increase to 700–1000 if silence detection fires too early
AI_RECORD_SILENCE_THRESHOLD_MS=500

# Optional: trailing silence (seconds) the AI waits after the caller stops
# speaking before it treats the turn as finished and processes the utterance.
# Default: 2.6 — higher values reduce premature interruptions but add response
# latency after the caller genuinely stops talking
AI_RECORD_SILENCE_SECONDS=2.6

# Optional: webhook URL called (POST) when a call starts ringing
# Payload: {"event":"ringing","caller":"...","caller_name":"...","ringing_since":"..."}
AI_RING_WEBHOOK_URL=


# ------------------------------------------------------------------------------
# FREESWITCH ESL (Event Socket Layer)
# FreeSWITCH must be running and configured to use the outbound socket.
# See backend/voice/freeswitch/ for example dialplan and gateway XML files.
# ------------------------------------------------------------------------------

# FreeSWITCH ESL inbound connection (Python → FreeSWITCH, port 8021)
FREESWITCH_ESL_HOST=127.0.0.1
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=ClueCon

# Port Python listens on for FreeSWITCH outbound socket connections (FreeSWITCH → Python)
# Must match the port in the dialplan: <action application="socket" data="HOST:PORT async full"/>
FREESWITCH_ESL_OUTBOUND_PORT=8085

# Inbound dialplan socket endpoint — the address FreeSWITCH dials back to reach
# the Python backend's ESL outbound listener. The repo dialplan template
# (backend/voice/freeswitch/inbound_ai_dialplan.xml) is host-agnostic: it carries
# {{AI_ESL_OUTBOUND_HOST}} / {{AI_ESL_OUTBOUND_PORT}} placeholders that are
# rendered into the deployed FreeSWITCH XML by render_inbound_dialplan.sh.
#
# Default local setup (FreeSWITCH and backend in the same WSL instance):
#   AI_ESL_OUTBOUND_HOST=127.0.0.1
#   AI_ESL_OUTBOUND_PORT=8085
#
# WSL/Windows portproxy setup (backend on Windows, FreeSWITCH in WSL): set HOST to
# the LAN/host IP the netsh portproxy forwards from, e.g.
#   AI_ESL_OUTBOUND_HOST=172.20.0.42
#   AI_ESL_OUTBOUND_PORT=8085
# (Do NOT commit a local IP into the dialplan template — only render it.)
#
# Docker/Linux: set HOST to the backend container/host address FreeSWITCH can reach.
#
# If unset, the renderer falls back to FREESWITCH_ESL_OUTBOUND_HOST/PORT, then to
# 127.0.0.1:8085. Render + apply with:
#   bash backend/voice/freeswitch/render_inbound_dialplan.sh --reload
#   # or, to reload manually:  fs_cli -x "reloadxml"
AI_ESL_OUTBOUND_HOST=127.0.0.1
AI_ESL_OUTBOUND_PORT=8085

# Shared directory for temporary WAV files (recordings + TTS output).
# Must be writable by Python and readable by FreeSWITCH.
# On Windows+WSL: use a Windows path, e.g. C:\tmp\esl_audio
FREESWITCH_AUDIO_TEMP_DIR=./data/esl_audio


# ------------------------------------------------------------------------------
# ESCALATION EMAIL (optional — sends summary email when AI escalates a call)
# ------------------------------------------------------------------------------

ESCALATION_EMAIL_TO=
ESCALATION_EMAIL_FROM=
ESCALATION_SMTP_HOST=
ESCALATION_SMTP_PORT=587
ESCALATION_SMTP_USER=
ESCALATION_SMTP_PASS=
