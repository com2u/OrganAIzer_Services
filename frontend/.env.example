# =============================================================================
# OrganAIzer Frontend — Environment Variables
# Copy this file to frontend/.env and fill in your values.
# NEVER commit .env to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: API key for authenticating requests to the backend.
# Must match one of the keys listed in backend API_KEYS.
# -----------------------------------------------------------------------------
VITE_API_KEY=your_api_key_here

# -----------------------------------------------------------------------------
# OPTIONAL: Backend API base URL.
#
# This is auto-configured by vite.config.ts based on build mode:
#   - Development (npm run dev) → http://localhost:8000
#   - Production  (npm run build) → "" (empty = relative, nginx handles /api/*)
#
# Override here ONLY if your backend runs on a non-standard port/host, e.g.:
#   VITE_API_BASE_URL=http://localhost:9000
#
# Leave this unset for default behaviour in both dev and production.
# -----------------------------------------------------------------------------
# VITE_API_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# PROVIDER DECISION BEHAVIOUR (set on the BACKEND, not here)
#
# The frontend does NOT hard-lock a calendar or mail provider via env vars.
# Provider selection follows this hierarchy (enforced by the Executive Agent):
#
#   1. Explicit user mention   → "send via Outlook" / "use Google Calendar"
#   2. Session-locked provider → only ONE integration connected (auto-detected)
#   3. Clarification question  → backend asks "Google or Microsoft?" when both
#      are connected or neither is connected
#
# The frontend queries /api/integrations/google/status and
# /api/integrations/microsoft/status on mount and passes the detected provider
# only when exactly ONE integration is active. For ambiguous cases (both or
# neither connected) the provider fields are omitted so the backend asks.
#
# Voice WebSocket params calendar_provider and mail_provider follow the same
# logic: they are only appended when exactly one integration is connected.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# USER IDENTITY
#
# The user_id sent with every agent chat request and integration status queries
# is currently hardcoded to "default_user" in the frontend components.
#
# For multi-user deployments this should be populated from your auth system
# (e.g. a JWT sub claim). This is a known limitation for future work.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# VOICE WEBSOCKET SETTINGS
#
# The voice WebSocket connects to: ws(s)://<host>/api/voice/stream
#   - In development: derived from VITE_API_BASE_URL (ws://localhost:8000)
#   - In production:  derived from window.location (same-origin, nginx proxy)
#
# WebSocket URL parameters:
#   session_id  — auto-generated unique session identifier per page load
#   user_id     — hardcoded "voice_user" / "default_user"
#   calendar_provider — only included when exactly one integration is connected
#   mail_provider     — only included when exactly one integration is connected
#
# IMPORTANT: Do NOT set these here. They are computed at runtime from
# integration state. Hardcoding them bypasses provider clarification logic.
# -----------------------------------------------------------------------------
