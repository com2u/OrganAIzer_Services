# Organizer Service Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# BACKEND CONFIGURATION
# ============================================

# Google AI Studio (Gemini image generation)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Configuration (for LLM)
OPENROUTER_API_KEY=your_openrouter_api_key_here
MODEL=google/gemini-2.5-flash

# Microsoft / Azure (Outlook + Calendar)
MICROSOFT_CLIENT_ID=your_azure_application_client_id
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_SECRET=your_azure_client_secret_value

# Token encryption key (Fernet)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=your_fernet_encryption_key_here

# API Keys for backend authentication (comma-separated)
# These keys will be used by the frontend to authenticate with the backend
API_KEYS=your-api-key-1,your-api-key-2

# ============================================
# FRONTEND CONFIGURATION
# ============================================

# Frontend API Key (must match one of the API_KEYS above)
VITE_API_KEY=your-api-key-here

# Frontend API URL (for development)
VITE_API_URL=http://localhost:8000/api

# Production Backend API URL
VITE_API_URL_PROD=https://your-backend-domain.example.com

# ============================================
# DEPLOYMENT CONFIGURATION
# ============================================

# Backend URL for production deployment
BACKEND_URL=https://your-backend-domain.example.com

# Frontend URL for production deployment
FRONTEND_URL=https://your-frontend-domain.example.com

# ============================================
# SECURITY & API CONFIGURATION
# ============================================

# Session secret for backend (generate a strong random string)
SESSION_SECRET=your_session_secret_here

# Database URL (if using a database)
DATABASE_URL=your_database_url_here

# ============================================
# OPTIONAL: Custom Ports (for local development)
# ============================================

# Backend port (default: 8000)
# BACKEND_PORT=8000

# Frontend port (default: 5264)
# FRONTEND_PORT=5264

# ============================================
# API RATE LIMITING (Optional)
# ============================================

# Rate limit requests per minute per API key
RATE_LIMIT_PER_MINUTE=60

# ============================================
# LOGGING CONFIGURATION
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================
# SECURITY NOTES
# ============================================
# 1. Keep this .env file secure and never commit it to version control
# 2. Use strong, unique API keys for each environment
# 3. Rotate API keys regularly
# 4. Use HTTPS in production
# 5. Enable CORS restrictions in production
# 6. Monitor API usage and set up alerts